{
  "name": "bookly",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.3.4",
  "description": "Bookly \u2014 a self-hostable scheduling platform with Google Meet, Zoom, Teams and Bookly video.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter @bookly/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @bookly/web e2e:build && pnpm --filter @bookly/web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @bookly/db generate",
    "db:migrate": "pnpm --filter @bookly/db migrate",
    "db:studio": "pnpm --filter @bookly/db studio",
    "auth:generate": "pnpm --filter @bookly/web auth:generate",
    "demo": "pnpm --filter @bookly/web demo",
    "docker:db": "docker compose up -d postgres"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "@typescript/native": "catalog:"
  }
}
