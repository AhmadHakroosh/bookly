{
  "id": "/admin",
  "name": "Bookly",
  "short_name": "Bookly",
  "description": "Your bookings, contacts and follow-ups, with notifications on this device.",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "background_color": "#faf8f4",
  "theme_color": "#1c1c1c",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/apple-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/notification-icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo-mark.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Bookings",
      "url": "/admin/bookings"
    },
    {
      "name": "Contacts",
      "url": "/admin/contacts"
    },
    {
      "name": "Notifications",
      "url": "/admin/notifications"
    }
  ]
}
