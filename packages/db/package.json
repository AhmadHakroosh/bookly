{
  "name": "@bookly/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "studio": "drizzle-kit studio",
    "build:migrator": "esbuild src/migrate-cli.ts --bundle --platform=node --target=node24 --format=cjs --external:pg-native --outfile=dist/migrate.cjs"
  },
  "dependencies": {
    "@bookly/config": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "dotenv": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "@typescript/native": "catalog:",
    "esbuild": "^0.28.2"
  }
}
