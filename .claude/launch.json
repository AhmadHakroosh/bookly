{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bookly-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@bookly/web", "dev"],
      "port": 3002
    },
    {
      "name": "bookly-web-cloud",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "TENANCY=multi",
        "APP_URL=http://localhost:3002",
        "ROOT_DOMAIN=localhost:3002",
        "PLATFORM_ADMIN_EMAILS=demo@example.com",
        "pnpm",
        "--filter",
        "@bookly/web",
        "dev"
      ],
      "port": 3002
    }
  ]
}
