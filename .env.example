# ---------- Core ----------
# single: one workspace, no tenant UI (self-host default). multi: SaaS mode.
TENANCY=single
# Public URL of this deployment (single mode: the blog's URL; multi mode: the platform's root URL).
APP_URL=http://localhost:3002
# Root domain for tenant subdomains in multi mode (e.g. bookly.app -> <slug>.bookly.app). Optional in single mode.
ROOT_DOMAIN=localhost:3002

DATABASE_URL=postgres://bookly:bookly@localhost:5433/bookly

# openssl rand -base64 32
AUTH_SECRET=change-me

# ---------- Email (console | resend | smtp) ----------
EMAIL_DRIVER=console
EMAIL_FROM="Bookly <noreply@localhost>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ---------- Storage (local | s3) ----------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
S3_BUCKET=bookly
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY_ID=bookly
S3_SECRET_ACCESS_KEY=bookly-secret
S3_PUBLIC_URL=http://localhost:9002/bookly
S3_FORCE_PATH_STYLE=true

# ---------- Integrations (optional; see docs/integrations.md) ----------
# Google Calendar + Google Meet. Redirect URI: <APP_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Outlook Calendar + Microsoft Teams. Redirect URI: <APP_URL>/api/integrations/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Zoom (OAuth app). Redirect URI: <APP_URL>/api/integrations/zoom/callback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Built-in video via Daily.co. Rooms are served at MEET_URL (defaults to <APP_URL>/meet).
DAILY_API_KEY=
DAILY_DOMAIN=
# MEET_URL=https://meet.example.com

# ---------- Payments (optional; docs/payments.md) ----------
# Paid event types redirect to Stripe Checkout. Webhook: <APP_URL>/api/webhooks/stripe (checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Cloud mode only: hosts connect their own Stripe accounts (Connect Express) and get paid directly.
# Second webhook endpoint, "Listen to events on Connected accounts": <APP_URL>/api/webhooks/stripe/connect
# (checkout.session.completed, checkout.session.async_payment_succeeded, account.updated). The platform fee is set in /console/payments.
STRIPE_CONNECT_WEBHOOK_SECRET=

# ---------- Cloud mode (TENANCY=multi; docs/cloud.md) ----------
# Platform host = APP_URL (marketing, sign-up, pricing, /console). Tenants live at <slug>.ROOT_DOMAIN.
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
PLATFORM_ADMIN_EMAILS=
# Contact address shown on the cloud marketing site (contact, legal pages, footer)
SUPPORT_EMAIL=

# ---------- Text messages (optional; docs/notifications.md) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_SMS=
TWILIO_FROM_WHATSAPP=

# ---------- Update check and telemetry ----------
# Once a day the install asks for the latest version, sending its version, tenancy and an anonymous
# install id (nothing about people or content). Set TELEMETRY=off to disable. Sharing coarse usage
# statistics (counts only) is a separate opt-in under Admin -> Settings.
# TELEMETRY=on
# TELEMETRY_URL=https://bookly-app.io/api/telemetry

# ---------- Optional ----------
# SKIP_ENV_VALIDATION=1

# ---------- Shared rate limiting (multi-instance / serverless) ----------
# Public-form throttles, API limits and sign-in limits count per process unless these are set.
# Any Upstash Redis database works; required on Vercel, unnecessary for one Docker container.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---------- Serverless (Vercel) ----------
# Disable the in-process pg-boss worker. With QStash configured, jobs and schedules run through
# it (precise reminders, retries, dead-letter queue); /api/cron/tick stays as a manual fallback.
# JOBS_WORKER=false
# CRON_SECRET=
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# QSTASH_URL=https://qstash.upstash.io

# ---- Assistant (optional): pre-meeting briefings and meeting capture ----
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-sonnet-5

# ---- Observability (optional): Prometheus text at GET /api/metrics with this bearer token ----
# METRICS_TOKEN=

# ---- Error tracking (optional): Sentry ----
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG= / SENTRY_PROJECT= / SENTRY_AUTH_TOKEN= for source-map upload at build
